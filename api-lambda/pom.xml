<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        api-lambda-pom.xml — Business Logic API Lambda module
        =======================================================
        Location in repository: lambda-authorizer-service/api-lambda/pom.xml

        This module produces a deployable shaded fat JAR for all API handler
        Lambda functions (CRUD operations on fasteners). The shade plugin
        bundles all runtime dependencies into a single self-contained artifact.

        Build output:
          target/api-lambda-1.0.0.jar  ← deployed to AWS Lambda

        Lambda handlers:
          com.gridgrizzly.api.FastenersHandler::handleRequest
          com.gridgrizzly.api.CreateFastenerHandler::handleRequest
          com.gridgrizzly.api.GetFastenerHandler::handleRequest
          com.gridgrizzly.api.DeleteFastenerHandler::handleRequest
          com.gridgrizzly.api.UpdateFastenerHandler::handleRequest

        To build:
          mvn clean package                (from this directory)
          mvn -pl api-lambda package       (from the repository root)
    -->

    <parent>
        <groupId>com.gridgrizzly</groupId>
        <artifactId>lambda-authorizer-service</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>api-lambda</artifactId>
    <packaging>jar</packaging>

    <name>API Lambda — Business Logic Handlers</name>
    <description>
        Deployable AWS Lambda functions for the GridGrizzly REST API.
        Contains all CRUD handlers for fastener resources, backed by DynamoDB.
        Produces a shaded fat JAR containing all runtime dependencies.
    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.42.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- AWS Lambda runtime -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-events</artifactId>
        </dependency>

        <!-- AWS SDK v2 DynamoDB -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
        </dependency>

        <!-- JSON serialisation -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.14.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.14.2</version>
        </dependency>

        <!-- Logging: writes to stdout → CloudWatch Logs -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!--
                Shade plugin: packages all runtime dependencies into a single
                fat JAR that Lambda can execute. Version and signature-stripping
                filter are inherited from the parent pluginManagement block.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-lambda-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
